<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Chat Here</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      display: flex;
      flex-direction: column;
      height: 100vh;
      background-color: #f0f2f5;
    }

    header {
      padding: 1rem;
      background-color: #4a90e2;
      color: white;
      text-align: center;
      font-size: 1.5rem;
      font-weight: bold;
    }

    #message-container {
      flex: 1;
      padding: 1rem;
      overflow-y: auto;
      margin-bottom: 70px;
    }

    .chatform {
      display: flex;
      padding: 10px;
      background-color: white;
      border-top: 1px solid #ccc;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
    }

    .messagebox {
      flex: 1;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 20px;
      font-size: 1rem;
      outline: none;
    }

    .submit-button {
      padding: 10px 20px;
      margin-left: 10px;
      background-color: #4a90e2;
      color: white;
      border: none;
      border-radius: 20px;
      cursor: pointer;
      font-size: 1rem;
      transition: background-color 0.3s ease;
    }

    .submit-button:hover {
      background-color: #357ab8;
    }

    .message {
      max-width: 60%;
      padding: 0.75rem;
      margin: 0.5rem;
      border-radius: 0.5rem;
      word-break: break-word;
      font-size: 1rem;
    }

    .sent-container {
      display: flex;
      justify-content: flex-end;
    }

    .received-container {
      display: flex;
      justify-content: flex-start;
    }

    .sent {
      background-color: #3B82F6;
      color: white;
    }

    .received {
      background-color: #D1D5DB;
      color: #1F2937;
    }
  </style>
</head>
<body>
  <header>Chat Here</header>

  <div id="message-container"></div>

  <form class="chatform">
    <input type="text" class="messagebox" placeholder="Type your message..." />
    <button class="submit-button">Submit</button>
  </form>

  <script src="https://cdn.socket.io/4.8.1/socket.io.min.js"
    integrity="sha384-mkQ3/7FUtcGyoppY6bz/PORYoGqOl7/aSUMn2ymDOJcapfS6PHqxhRTMh1RR0Q6+"
    crossorigin="anonymous">
  </script>

  <script>
    let room;
    const socket = io();

    socket.emit("join room");

    socket.on("joined", function(roomname) {
      room = roomname;
    });

    const chatform = document.querySelector(".chatform");
    const messagebox = document.querySelector(".messagebox");

    chatform.addEventListener("submit", function(event) {
      event.preventDefault();
      const msg = messagebox.value.trim();
      if (msg === "") return;

      socket.emit("message", { room: room, message: msg });

      attachMessage(msg);
      messagebox.value = "";
    });

    socket.on("message", function(message) {
      receiveMessage(message);
    });

    const messageContainer = document.getElementById("message-container");

    function attachMessage(message) {
      const container = document.createElement('div');
      container.className = 'sent-container';

      const msg = document.createElement('div');
      msg.className = 'message sent';
      msg.textContent = message;

      container.appendChild(msg);
      messageContainer.appendChild(container);
      scrollToBottom();
    }

    function receiveMessage(message) {
      const container = document.createElement('div');
      container.className = 'received-container';

      const msg = document.createElement('div');
      msg.className = 'message received';
      msg.textContent = message;

      container.appendChild(msg);
      messageContainer.appendChild(container);
      scrollToBottom();
    }

    function scrollToBottom() {
      messageContainer.scrollTop = messageContainer.scrollHeight;
    }
  </script>
</body>
</html>
