/* Base Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Segoe UI', sans-serif;
}

/* Body Theme */
body {
  background: linear-gradient(to right, #1f1c2c, #2b5876); /* Dark gradient */
  color: white;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Header */
header {
  text-align: center;
  padding: 1.5rem;
  font-size: 2rem;
  font-weight: bold;
  background: linear-gradient(to right, #8e2de2, #4a00e0);
  color: #ffffff;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.4);
}

/* Message container */
#message-container {
  flex: 1;
  padding: 1rem;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  background-color: #121212;
  scroll-behavior: smooth;
}

/* Chat form container */
.chatform {
  background-color: #1e1e2f;
  padding: 1rem;
  display: flex;
  justify-content: center;
  border-top: 1px solid #333;
  position: sticky;
  bottom: 0;
  z-index: 10;
}

/* Input and button layout */
.chatform div {
  display: flex;
  width: 100%;
  max-width: 900px;
  gap: 0.5rem;
}

/* Input box */
.messagebox {
  flex: 1;
  padding: 0.8rem 1rem;
  border: none;
  border-radius: 25px;
  font-size: 1rem;
  background-color: #2c2f3f;
  color: #ffffff;
  outline: none;
}

/* Submit button */
.submit-button {
  padding: 0.8rem 1.2rem;
  background: linear-gradient(to right, #6a11cb, #2575fc);
  border: none;
  border-radius: 25px;
  color: white;
  font-size: 1rem;
  cursor: pointer;
  transition: 0.3s ease;
}

.submit-button:hover {
  background: linear-gradient(to right, #5d0cff, #1d71f2);
  transform: scale(1.05);
}

/* Scrollbar styling for chat container */
#message-container::-webkit-scrollbar {
  width: 8px;
}

#message-container::-webkit-scrollbar-thumb {
  background: #444;
  border-radius: 4px;
}

#message-container::-webkit-scrollbar-track {
  background: #222;
}
