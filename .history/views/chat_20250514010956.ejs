<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8">
  <title>Chating</title>
  <!-- <link rel="stylesheet" href="/stylesheet\chat.css">  -->
   <style>
    /* Global Styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Arial', sans-serif;
}

body {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  background-color: #f0f2f5; /* Light gray background */
  color: #333;
}

/* Centered Chat Container */
.chat-container {
  background-color: #ffffff;
  padding: 20px;
  border-radius: 8px;
  width: 90%; /* Take up 90% of the screen width */
  max-width: 400px; /* Set a maximum width for larger screens */
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  height: 90vh; /* Take up 90% of the screen height */
}

/* Header */
header {
  text-align: center;
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 20px;
}

/* Message Container */
.message-container {
  overflow-y: auto;
  flex-grow: 1;
  margin-bottom: 20px;
  padding: 10px;
  background-color: #f8f9fa;
  border-radius: 8px;
  max-height: 70vh; /* Limit height for message scrolling */
}

.user-message-container,
.receive-message-container {
  margin-bottom: 10px;
}

.user-message, 
.receive-message {
  max-width: 90%;
  padding: 12px;
  border-radius: 12px;
  font-size: 16px;
  line-height: 1.4;
  word-wrap: break-word;
}

.user-message {
  background-color: #007bff; /* Blue for user message */
  color: white;
  align-self: flex-end;
}

.receive-message {
  background-color: #e9ecef; /* Light gray for received message */
  color: #495057;
  align-self: flex-start;
}

/* Form Styles */
.chatform {
  display: flex;
  margin-top: 10px;
}

.messagebox {
  width: 80%;
  padding: 12px;
  border: 1px solid #ced4da;
  border-radius: 20px;
  font-size: 16px;
  margin-right: 10px;
}

.submit-button {
  padding: 12px 20px;
  background-color: #007bff;
  color: white;
  border: none;
  border-radius: 20px;
  cursor: pointer;
  font-size: 16px;
}

.submit-button:hover {
  background-color: #0056b3;
}

/* File Upload */
form[action="/chat"] {
  display: flex;
  margin-top: 10px;
}

input[type="file"] {
  padding: 8px;
  border: 1px solid #ced4da;
  border-radius: 5px;
  font-size: 14px;
  margin-right: 10px;
}

input[type="submit"] {
  padding: 8px 15px;
  background-color: #28a745;
  color: white;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

input[type="submit"]:hover {
  background-color: #218838;
}

   </style>
  

</head>



<body>
  <header>Chat Here</header>

  <div id="message-container">

  </div>



<form class="chatform">

 

    <input type="text" class="messagebox"  placeholder="Type your message..."  />
    <button class="submit-button">Submit</button>


</form>

<form action="/chat" method="post" enctype="multipart/form-data" preventDefault() >
  <input type="file" name="image">
  <input type="submit">
</form>






<!-- SOCKET IO CODE START -->
  <script src="https://cdn.socket.io/4.8.1/socket.io.min.js" 
    integrity="sha384-mkQ3/7FUtcGyoppY6bz/PORYoGqOl7/aSUMn2ymDOJcapfS6PHqxhRTMh1RR0Q6+" 
    crossorigin="anonymous">
  </script>


  <script>

    let room;
    const socket=io();
    socket.emit("join room");
    socket.on("joined",function(roomname)

  {

    room=roomname;

  })







    // writing the code for input box...............................




  const chatform=document.querySelector(".chatform")
  const messagebox=document.querySelector(".messagebox")
  const messagecontainer=document.querySelector(".messagecontainer")
  chatform.addEventListener("submit",function(event)

  {
  event.preventDefault();
  
 

    socket.emit("message",{room:room , message:messagebox.value})
    attachMessage(messagebox.value)
    messagebox.value=""
  
  



  })



  // here message comming from the backend  display in the messagecontainer


  socket.on("message",function(message)
{

    // here reciever message display
    
  receiveMessage(message)
    
})









function attachMessage(message) {
  const userMessageContainer = document.createElement('div');
userMessageContainer.style.display = 'flex';
userMessageContainer.style.marginTop = '0.5rem';
userMessageContainer.style.marginBottom = '0.5rem';
userMessageContainer.style.justifyContent = 'flex-end';

const userMessageDiv = document.createElement('div');

userMessageDiv.style.backgroundColor = '#3B82F6'; // Tailwind bg-blue-500
userMessageDiv.style.color = 'white';             // text-white
userMessageDiv.style.padding = '0.75rem';         // p-3 = 12px = 0.75rem
userMessageDiv.style.borderRadius = '0.5rem';     // rounded-lg = 0.5rem
userMessageDiv.style.maxWidth = '20rem';          // max-w-xs = 320px = 20rem

                

const userMessageText = document.createElement('p');
userMessageText.textContent = message;

userMessageDiv.appendChild(userMessageText);

userMessageContainer.appendChild(userMessageDiv);

document.getElementById('message-container').appendChild(userMessageContainer);

document.querySelector("#message-container").scrollTop = document.querySelector("#message-container").scrollHeight;
            }


function receiveMessage(message) {
const messageContainer = document.createElement('div');
messageContainer.style.display = 'flex';               // flex
messageContainer.style.marginTop = '0.5rem';           // my-2 = mt-2 + mb-2 = 0.5rem
messageContainer.style.marginBottom = '0.5rem';
messageContainer.style.justifyContent = 'flex-start';  // justify-start


const messageDiv = document.createElement('div');
messageDiv.style.backgroundColor = '#D1D5DB';           // bg-gray-300
messageDiv.style.color = '#1F2937';                    // text-gray-800
messageDiv.style.padding = '0.75rem';                  // p-3 = 12px = 0.75rem
messageDiv.style.borderRadius = '0.5rem';              // rounded-lg = 0.5rem
messageDiv.style.maxWidth = '20rem';                   // max-w-xs = 320px = 20rem


const messageText = document.createElement('p');
messageText.textContent = message;

messageDiv.appendChild(messageText);

messageContainer.appendChild(messageDiv);

document.getElementById('message-container').appendChild(messageContainer);
document.querySelector("#message-container").scrollTop = document.querySelector("#message-container").scrollHeight;
}  



  </script>
  


</body>
</html>



