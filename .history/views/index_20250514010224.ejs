<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Chating </title>
  <!-- <link rel="stylesheet" href="./stylesheet\index.css"> -->
   <style>
    /* Global Styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Arial', sans-serif;
}

body {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  font-size: 18px;
  text-align: center;
  transition: background-color 0.3s ease, color 0.3s ease;
}

body.light-mode {
  background-color: #f5f5f5; /* Light mode background */
  color: #333; /* Dark text for light mode */
}

body.dark-mode {
  background-color: #121212; /* Dark mode background */
  color: #fff; /* Light text for dark mode */
}

/* Center Container Styles */
.center-container {
  background: rgba(255, 255, 255, 0.8); /* Light background for the container */
  padding: 30px 50px;
  border-radius: 15px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
  width: 400px; /* Fixed width for center alignment */
}

body.dark-mode .center-container {
  background: rgba(0, 0, 0, 0.7); /* Darker container background in dark mode */
}

/* Heading */
.center-container h1 {
  font-size: 36px;
  margin-bottom: 20px;
  text-transform: uppercase;
}

/* Button Styles */
.center-container a {
  display: inline-block;
  padding: 15px 30px;
  background: #ff7e5f; /* Trending color */
  color: white;
  text-decoration: none;
  border-radius: 25px;
  font-size: 18px;
  transition: background 0.3s ease, transform 0.3s ease;
}

/* Button Hover Effects */
.center-container a:hover {
  background: #feb47b; /* Hover color */
  transform: scale(1.1);
}

   </style>
</head>
<body>
  <div class="center-container">
    <h1>Welcome to the Chat</h1>
    <a href="/chat">Start Chat </a>
  </div>
</body>
</html>
