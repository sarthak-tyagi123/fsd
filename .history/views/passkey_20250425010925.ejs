<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>passkey for chat</title>
    <link rel="stylesheet" href="./stylesheet\passkey.css">
</head>
<body>
   <div class="main-div">

    <form action="/chat">

        <div class="passkey">

            <input type="text" name="text" class="passkeybox"      placeholder="Create your room passkey "><br>
            <input type="submit" class="submitbutton" >

        </div>

    </div>

    </form>



    <script>

        const passkeybox = document.querySelector('.passkeybox');
        const submitButton = document.querySelector('.submitbutton');

        submitButton.addEventListener('submit', function(event) {
            event.preventDefault(); // Prevent form submission
            const passkey = passkeybox.value;
            if (passkey=="") {
                window.location.href = `/chat?passkey=${encodeURIComponent(passkey)}`;
            } else {
                alert('Please enter a passkey.');
            }
        });

            
    </script>

</body>
</html>