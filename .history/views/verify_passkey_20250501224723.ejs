<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>verify passkey</title>
    <link rel="stylesheet" href="./stylesheet\verify_passkey.css">
</head>
<body>
    
    <div class="main-div">

        <form id="passkeyForm">
          <div class="passkey">
            <input type="text" name="text" class="passkeybox" placeholder="Enter the partner 1 passkey"><br>
            <input type="text" name="text" class="passkeybox" placeholder="Enter partner 2 passkey"><br>
            <button></button>
          </div>
        </form>
    
      </div>
    




      <script>


        const passkeyForm = document.getElementById('passkeyForm');
        const passkeybox = document.querySelector('.passkeybox');
    
        passkeyForm.addEventListener('submit', function(event) {
          event.preventDefault(); // Prevent form's default behavior
          const passkey = passkeybox.value.trim();
          if (passkey) {
            window.location.href = `/chat?room=${encodeURIComponent(passkey)}`;
          } else {
            alert("Please verify the passkey first to start chatting");
          }
    
        });
    
    
        
    
      </script>
    









       


</body>
</html>